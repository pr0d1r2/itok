/// itok's gate, defined ONCE (V64).
///
/// Every op below is a plain cargo command a human can paste into a shell.
/// hk decides *when* they run (which files changed, which phase, in what
/// order); it never hides *what* runs. The workflow in
/// `.github/workflows/ci.yml` calls `hk check` rather than restating these
/// commands, so a local hook and CI cannot disagree -- there is only one
/// copy to disagree with.
///
/// The schema is VENDORED at `pkl/Config.pkl` rather than fetched from a
/// `package://` URL at eval time, for the same reason the BPE vocab ships
/// in-tree (V12): offline-first is the default build, not merely the
/// default flag.
amends "pkl/Config.pkl"

/// Unix philosophy: a passing gate says NOTHING. `hk` reports every step
/// on stderr by default, which is noise in the commit path -- and noise
/// that agents and humans both learn to scroll past, which is how a real
/// failure gets missed. Success is silence; failure is loud and carries
/// its own remediation.
///
/// `fail_fast` is the default, set here explicitly because it is a
/// decision, not an accident: locally the loop is cheap, so the FIRST
/// failure is the most useful thing to surface, and the steps are ordered
/// cheapest-first via `depends` so it arrives fast. CI inverts this
/// (`--no-fail-fast`): there the round-trip is expensive, so a complete
/// list beats an early one.
fail_fast = true

env {
  ["HK_HIDE_WHEN_DONE"] = "true"
}

/// `depends` chains the cargo steps deliberately (V67). Cargo takes a lock
/// on the target directory, so two cargo jobs launched in parallel do not
/// run in parallel -- the second blocks on "Blocking waiting for file lock
/// on build directory", which reads as a hang. Chaining makes the
/// serialization explicit and leaves hk free to run any future non-cargo
/// check concurrently.
local fast = new Mapping<String, Step> {
  ["fmt"] {
    glob = List("**/*.rs")
    check = "cargo fmt --check"
    fix = "cargo fmt"
  }
  ["clippy"] {
    glob = List("**/*.rs")
    depends = List("fmt")
    check = "cargo clippy --all-targets --all-features -- -D warnings"
  }
  // nextest runs each test in its OWN process. That isolation is why it
  // is worth an extra tool: B5 was a race between concurrently running
  // tests, and process-per-test makes that class harder to write in the
  // first place.
  ["test"] {
    glob = List("**/*.rs")
    depends = List("clippy")
    check = "cargo nextest run"
  }
  // nextest does not run doctests -- that is the one gap it opens, so it
  // is closed explicitly rather than left implicit. Currently zero
  // doctests; this is what notices when the first one arrives and fails.
  ["doctest"] {
    glob = List("**/*.rs")
    depends = List("test")
    check = "cargo test --doc"
  }
  // Hygiene, all of it `hk util` -- native to the runner, so it needs no
  // extra binary in the shell or on a CI runner. That matters: the gate
  // of record stays reproducible with rustup alone (V65), and these are
  // the FIRST non-cargo steps, so they are also the first that genuinely
  // run in parallel rather than queueing behind the target-dir lock
  // (V67).
  //
  // `pkl/` is excluded from every fixer: it is upstream's schema,
  // vendored VERBATIM (V66), and reformatting it would silently fork it.
  // The cassette is a RECORDING -- editing bytes invalidates it (V38).
  ["trailing-whitespace"] {
    glob = List("**/*")
    exclude = List("pkl/**", "tests/fixtures/**")
    check_diff = "hk util trailing-whitespace --diff {{files}}"
    fix = "hk util trailing-whitespace --fix {{files}}"
  }
  ["final-newline"] {
    glob = List("**/*")
    exclude = List("pkl/**", "tests/fixtures/**")
    check_diff = "hk util end-of-file-fixer --diff {{files}}"
    fix = "hk util end-of-file-fixer --fix {{files}}"
  }
  ["line-endings"] {
    glob = List("**/*")
    exclude = List("pkl/**", "tests/fixtures/**")
    check_diff = "hk util mixed-line-ending --diff {{files}}"
    fix = "hk util mixed-line-ending --fix {{files}}"
  }
  ["no-bom"] {
    glob = List("**/*")
    check = "hk util check-byte-order-marker {{files}}"
  }
  ["no-merge-conflict"] {
    glob = List("**/*")
    check = "hk util check-merge-conflict --assume-in-merge {{files}}"
  }
  // Irreversible if it ever fires late -- a key in git history stays in
  // git history.
  ["no-private-key"] {
    glob = List("**/*")
    check = "hk util detect-private-key {{files}}"
  }
  ["no-large-files"] {
    glob = List("**/*")
    check = "hk util check-added-large-files {{files}}"
  }
  // A crate that ships to case-insensitive filesystems (macOS, Windows)
  // cannot afford two paths differing only in case.
  ["no-case-conflict"] {
    glob = List("**/*")
    check = "hk util check-case-conflict {{files}}"
  }
  ["no-broken-symlinks"] {
    glob = List("**/*")
    check = "hk util check-symlinks {{files}}"
  }
  // Steps below need a real binary, unlike the `hk util` family (V72).
  // Pinned in the dev shell and installed in CI so both run the same
  // versions.
  ["typos"] {
    glob = List("**/*")
    // --force-exclude: `.typos.toml`'s excludes are ignored for paths
    // passed explicitly, and hk always passes them explicitly. Without
    // it the vendored schema and the cassette get scanned.
    check = "typos --force-exclude {{files}}"
    fix = "typos --force-exclude --write-changes {{files}}"
  }
  // The workflow is code too, and it is the one file no local run
  // exercises -- a mistake there is found by pushing (V64: orchestration
  // stays in ci.yml, so nothing else can catch its errors).
  ["actionlint"] {
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    check = "actionlint {{files}}"
  }
  ["taplo"] {
    glob = List("**/*.toml")
    exclude = List("pkl/**")
    check = "taplo format --check --diff {{files}}"
    fix = "taplo format {{files}}"
  }
  // `.envrc` is shell without a `.sh` name, and it is the file that runs
  // on every shell entry -- exactly where a silent mistake costs most.
  ["shellcheck"] {
    glob = List("**/*.sh", "**/*.bash", ".envrc")
    check = "shellcheck --shell=bash {{files}}"
  }
  // The flake is the toolchain definition -- it decides what every other
  // step runs with, so drift here is drift everywhere. CHECK mode only:
  // this file is hand-commented, and a formatter that rewrites on commit
  // would fight the comments rather than the code.
  ["nixfmt"] {
    glob = List("**/*.nix")
    check = "nixfmt --check {{files}}"
    fix = "nixfmt {{files}}"
  }
  // itok gates itself (V14): `.context-limits` ceilings, checked by the
  // tool being built. Triggered by the registered paths and the registry
  // itself, so a docs-only commit still gets gated.
  ["itok"] {
    glob = List("**/*.rs", "SPEC.md", "README.md", ".context-limits")
    depends = List("doctest")
    check = "cargo run -q --bin itok -- check || { echo 'hk: a registered path is over its .context-limits ceiling. Compact the file; raising the ceiling is a reviewed decision. See AGENTS.md' >&2; exit 1; }"
  }
  // The FORMAT owner runs the format rules (V14). One implementation, and
  // itok CALLS it -- the ported copy this replaces is what drifted while
  // both gates stayed green, and it never looked at section B at all.
  //
  // HARD FAILURE when the binary is absent, deliberately. The usual rule
  // is that a hook degrades rather than blocks (V74), and it applies to a
  // RUNNER whose absence leaves another guard standing. Nothing else
  // checks this spec's structure now, so degrading here would let an
  // unchecked SPEC.md through while reading exactly like a pass -- V69's
  // defect, in the one place this repo already paid for it.
  //
  // The binary comes from the dev shell, which shims a sibling `../nanokit`
  // checkout. At release that becomes a pinned flake input and this step
  // does not change: it names the binary, never a path.
  ["nanokit"] {
    glob = List("SPEC.md", ".spec-records")
    depends = List("itok")
    check = "command -v nanokit >/dev/null 2>&1 || { echo 'hk: nanokit is not on PATH and nothing else checks SPEC.md structure. Enter the dev shell (direnv/nix develop) with a ../nanokit checkout beside this repo. See AGENTS.md' >&2; exit 1; }; nanokit fmt --check SPEC.md || { echo 'hk: SPEC.md is not formatted -- one line per statement, and no line over the cap. Run `nanokit fmt SPEC.md`; splitting an over-long statement is the fix, raising the cap is a reviewed decision. See AGENTS.md' >&2; exit 1; }"
  }
  // Split from the step above so a formatting failure and a structural one
  // are told apart by WHICH step went red, not by reading the message --
  // and `depends` means a misformatted file is fixed before its structure
  // is judged, which is the order the diagnostics make sense in.
  ["nanokit-check"] {
    glob = List("SPEC.md", ".spec-records")
    depends = List("nanokit")
    check = "nanokit check --records .spec-records SPEC.md || { echo 'hk: SPEC.md failed its structural rules. Each line above names the rule, the line, why it matters, and a ranked fix -- a `mechanical` direction is safe to apply unattended, a `judgment` one is not. See AGENTS.md' >&2; exit 1; }"
  }
}

/// pre-push and CI add the expensive axes. Amending `fast` keeps ONE
/// definition of the cheap steps -- the slow set is the fast set plus two,
/// never a second copy that can drift.
local all = (fast) {
  // V38: the network backend is cassette-replayed offline; this axis is
  // what keeps that path from rotting.
  ["ollama"] {
    glob = List("**/*.rs")
    depends = List("itok")
    check = "cargo nextest run --features ollama || { echo 'hk: the cassette-replayed network path broke. tests/fixtures is a RECORDING -- do not edit it to make a test pass. See AGENTS.md' >&2; exit 1; }"
  }
  // V23/V13/V34 claim the core builds with ZERO network deps as a
  // dummy-only tool. Until this step existed that claim rested on reading
  // Cargo.toml; now it is a build that passes or fails.
  ["no-default-features"] {
    glob = List("**/*.rs")
    depends = List("ollama")
    check = "cargo nextest run --no-default-features || { echo 'hk: the zero-dependency core stopped building -- something outside a cfg gate reached for an optional dep. See AGENTS.md' >&2; exit 1; }"
  }
  // V39: the published .crate must contain only consumer files. An
  // untracked-but-unignored directory silently lands in it -- that is
  // exactly how `.direnv/` (5.5MB of nixpkgs source) got in, and it was
  // found by hand rather than by the gate.
  ["package"] {
    glob = List("**/*.rs", "Cargo.toml", ".gitignore")
    depends = List("no-default-features")
    check = "cargo package --list --allow-dirty > /dev/null || { echo 'hk: the published .crate would hold the wrong files -- usually an untracked-but-unignored path. See AGENTS.md' >&2; exit 1; }"
  }
  // The docs.rs badge is a promise; broken intra-doc links break it
  // there, not here, unless this runs.
  ["rustdoc"] {
    glob = List("**/*.rs")
    depends = List("package")
    env { ["RUSTDOCFLAGS"] = "-D warnings" }
    check = "cargo doc --no-deps --all-features"
  }
  // The floor is itok's OWN standalone coverage, not a workspace
  // aggregate (B4). It lives here and nowhere else.
  ["coverage"] {
    glob = List("**/*.rs")
    depends = List("rustdoc")
    check = "cargo llvm-cov nextest --features ollama --fail-under-lines 98 || { echo 'hk: below the coverage floor. Cover the gap; lowering the floor needs a reason in SPEC.md. See AGENTS.md' >&2; exit 1; }"
  }
}

hooks {
  /// Fast set only: a hook you are tempted to `--no-verify` past is worse
  /// than no hook. `stash = "git"` is correctness, not speed -- without it
  /// a partially staged file (`git add -p`) is checked as it looks in the
  /// worktree, giving a verdict about code you are not committing.
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = fast
  }
  ["pre-push"] {
    steps = all
  }
  /// What `hk check` runs -- the CI entry point. Flat and complete: CI has
  /// no fail-fast-cheapest-first gradient to optimize for.
  ["check"] {
    steps = all
  }
  ["fix"] {
    fix = true
    steps = fast
  }
}
