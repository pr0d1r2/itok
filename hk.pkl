/// itok's gate, defined ONCE (V64).
///
/// Every op below is a plain cargo command a human can paste into a shell.
/// hk decides *when* they run (which files changed, which phase, in what
/// order); it never hides *what* runs. The workflow in
/// `.github/workflows/ci.yml` calls `hk check` rather than restating these
/// commands, so a local hook and CI cannot disagree -- there is only one
/// copy to disagree with.
///
/// The schema is VENDORED at `pkl/Config.pkl` rather than fetched from a
/// `package://` URL at eval time, for the same reason the BPE vocab ships
/// in-tree (V12): offline-first is the default build, not merely the
/// default flag.
amends "pkl/Config.pkl"

/// Unix philosophy: a passing gate says NOTHING. `hk` reports every step
/// on stderr by default, which is noise in the commit path -- and noise
/// that agents and humans both learn to scroll past, which is how a real
/// failure gets missed. Success is silence; failure is loud and carries
/// its own remediation.
///
/// `fail_fast` is the default, set here explicitly because it is a
/// decision, not an accident: locally the loop is cheap, so the FIRST
/// failure is the most useful thing to surface, and the steps are ordered
/// cheapest-first via `depends` so it arrives fast.
///
/// CI inverts it with `--no-fail-fast` on PUSH ONLY: on a PR the merge is
/// blocked by a red check either way, so the first failure in ninety
/// seconds beats a complete list in ten minutes; on main nobody is waiting,
/// so the complete list wins.
///
/// That flag was OFF entirely for a while, and the reason belongs HERE
/// rather than only in the workflow: under it hk emitted NOTHING once a
/// `depends`-chained step failed -- measured twice, 74 and 43 minutes of
/// silence, both ended by a kill rather than a verdict (B21). Fixed in hk
/// 1.55.0 and verified on the minimal fixture that hung 3/3 on 1.51.0, so
/// the `depends` graph and the flag compose again.
fail_fast = true

env {
  ["HK_HIDE_WHEN_DONE"] = "true"
  // Opts THIS repo in to the dogfood tests -- the ones that read itok's own
  // git history (tracked set, blobs at HEAD, HEAD~1..HEAD). They are gated
  // because the published .crate is not a git repo, so a consumer running
  // `cargo test` on registry source hit fourteen failures that nothing here
  // could see: `cargo package --verify` only COMPILES the tarball.
  //
  // Set globally rather than on the `test` step, so the ollama and
  // no-default-features runs and coverage all measure the same suite. The
  // one place it must NOT reach is `package-suite`, which unsets it on
  // purpose -- that step exists to be the consumer.
  ["ITOK_DOGFOOD"] = "1"
}

/// `depends` chains the cargo steps deliberately (V67). Cargo takes a lock
/// on the target directory, so two cargo jobs launched in parallel do not
/// run in parallel -- the second blocks on "Blocking waiting for file lock
/// on build directory", which reads as a hang. Chaining makes the
/// serialization explicit and leaves hk free to run any future non-cargo
/// check concurrently.
local fast = new Mapping<String, Step> {
  ["fmt"] {
    glob = List("**/*.rs")
    check = "cargo fmt --check"
    fix = "cargo fmt"
  }
  ["clippy"] {
    glob = List("**/*.rs")
    depends = List("fmt")
    check = "cargo clippy --all-targets --all-features -- -D warnings"
  }
  // nextest runs each test in its OWN process. That isolation is why it
  // is worth an extra tool: B5 was a race between concurrently running
  // tests, and process-per-test makes that class harder to write in the
  // first place.
  ["test"] {
    glob = List("**/*.rs")
    depends = List("clippy")
    check = "cargo nextest run"
  }
  // nextest does not run doctests -- that is the one gap it opens, so it
  // is closed explicitly rather than left implicit. Currently zero
  // doctests; this is what notices when the first one arrives and fails.
  ["doctest"] {
    glob = List("**/*.rs")
    depends = List("test")
    check = "cargo test --doc"
  }
  // Hygiene, all of it `hk util` -- native to the runner, so it needs no
  // extra binary in the shell or on a CI runner. That matters: the gate
  // of record stays reproducible with rustup alone (V65), and these are
  // the FIRST non-cargo steps, so they are also the first that genuinely
  // run in parallel rather than queueing behind the target-dir lock
  // (V67).
  //
  // `pkl/` is excluded from every fixer: it is upstream's schema,
  // vendored VERBATIM (V66), and reformatting it would silently fork it.
  // The cassette is a RECORDING -- editing bytes invalidates it (V38).
  ["trailing-whitespace"] {
    glob = List("**/*")
    exclude = List("pkl/**", "tests/fixtures/**")
    check_diff = "hk util trailing-whitespace --diff {{files}}"
    fix = "hk util trailing-whitespace --fix {{files}}"
  }
  ["final-newline"] {
    glob = List("**/*")
    exclude = List("pkl/**", "tests/fixtures/**")
    check_diff = "hk util end-of-file-fixer --diff {{files}}"
    fix = "hk util end-of-file-fixer --fix {{files}}"
  }
  ["line-endings"] {
    glob = List("**/*")
    exclude = List("pkl/**", "tests/fixtures/**")
    check_diff = "hk util mixed-line-ending --diff {{files}}"
    fix = "hk util mixed-line-ending --fix {{files}}"
  }
  // A smart quote inside a command is a DIFFERENT CHARACTER than the one
  // the shell parses, and it looks identical in a terminal. README.md,
  // AGENTS.md and CONTRIBUTING.md all carry commands meant to be copied,
  // so the failure lands on whoever pasted it -- and reads as their
  // mistake, not as a typo in our docs.
  //
  // MEASURED before landing, the same way microlith measured it: zero hits
  // across every tracked file of our own, one hit in `pkl/Config.pkl`.
  // That file is upstream's, excluded from every other fixer here for the
  // same reason, and is precisely the file that proves this can find
  // something rather than passing vacuously.
  ["smart-quotes"] {
    glob = List("**/*")
    exclude = List("pkl/**")
    check_diff = "hk util fix-smart-quotes --diff {{files}}"
    fix = "hk util fix-smart-quotes {{files}}"
  }
  ["no-bom"] {
    glob = List("**/*")
    check = "hk util check-byte-order-marker {{files}}"
  }
  ["no-merge-conflict"] {
    glob = List("**/*")
    check = "hk util check-merge-conflict --assume-in-merge {{files}}"
  }
  // Irreversible if it ever fires late -- a key in git history stays in
  // git history.
  ["no-private-key"] {
    glob = List("**/*")
    check = "hk util detect-private-key {{files}}"
  }
  ["no-large-files"] {
    glob = List("**/*")
    check = "hk util check-added-large-files {{files}}"
  }
  // A crate that ships to case-insensitive filesystems (macOS, Windows)
  // cannot afford two paths differing only in case.
  ["no-case-conflict"] {
    glob = List("**/*")
    check = "hk util check-case-conflict {{files}}"
  }
  ["no-broken-symlinks"] {
    glob = List("**/*")
    check = "hk util check-symlinks {{files}}"
  }
  // Steps below need a real binary, unlike the `hk util` family (V72).
  // Pinned in the dev shell and installed in CI so both run the same
  // versions.
  //
  // A leaked token in git history is IRREVERSIBLE, and this repo is about
  // to be published -- so now is the last moment the check is cheap.
  // Runs BESIDE `no-private-key`, not instead of it: that step matches PEM
  // blocks, this matches the token shapes it does not.
  //
  // MEASURED before landing, both halves: zero findings across the tracked
  // tree, and zero across the full history (`git log -p --all`, 35543
  // lines, every ref). The second number is the one that mattered, because
  // this step CANNOT see history -- it reads the files in front of it. The
  // pending history rewrite is for private path names, not secrets, and
  // that is now a measurement rather than an assumption.
  ["ripsecrets"] {
    glob = List("**/*")
    exclude = List("pkl/**")
    // `||` alone would report a LEAK when the tool is merely missing --
    // `command not found` is also a non-zero exit. A check that names the
    // wrong cause is worse than one that misses (B8), so absence is
    // distinguished from a finding before either is announced.
    check = """
      command -v ripsecrets >/dev/null 2>&1 || { echo 'hk: ripsecrets is not on PATH -- re-enter the dev shell (`nix develop`, or `direnv reload`). This is a MISSING TOOL, not a finding.' >&2; exit 1; }
      ripsecrets {{files}} || { echo 'hk: a possible secret is staged. If it is real it must never be committed -- a token in git history outlives its deletion, and this repo is headed for a public remote. If it is a false positive, add it to .secretsignore.' >&2; exit 1; }
      """
  }
  ["typos"] {
    glob = List("**/*")
    // --force-exclude: `.typos.toml`'s excludes are ignored for paths
    // passed explicitly, and hk always passes them explicitly. Without
    // it the vendored schema and the cassette get scanned.
    check = "typos --force-exclude {{files}}"
    fix = "typos --force-exclude --write-changes {{files}}"
  }
  // The workflow is code too, and it is the one file no local run
  // exercises -- a mistake there is found by pushing (V64: orchestration
  // stays in ci.yml, so nothing else can catch its errors).
  ["actionlint"] {
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    check = "actionlint {{files}}"
  }
  // The README badge block is GENERATED, like the `itok docs` command block
  // below it. Every number is read from the file that OWNS it -- edition and
  // MSRV from Cargo.toml, the floor from this file, coverage from the
  // `.coverage` cache, one badge per platform the flake actually builds.
  // Hand-maintaining them is a dozen chances to be wrong, and this repo has
  // already proved it: the MSRV badge said 1.82 for as long as the manifest
  // did, and a README example carried a monorepo path for months after the
  // extraction. A badge is a CLAIM, and V17 applies to claims in images too.
  //
  // CHEAP ON PURPOSE, so it can live in `fast` and run on every commit. The
  // one expensive input, coverage, is read from `.coverage`, which the
  // `coverage` step writes and verifies. `depends` orders the two when both
  // are in the set and is ignored in `fast`, where coverage is absent -- so
  // pre-commit regenerates from the cache and pre-push checks the cache
  // against a fresh measurement.
  //
  // TWO DEPENDENCY BADGES, not microlith's one, because itok's answer is not
  // a single number: the minimal tier resolves to ZERO and is gate-proven by
  // `no-default-features`, while the full tier is 60. A badge naming only one
  // of those would be true and misleading. Both link to
  // `docs/THIRD-PARTY-NOTICES.md`, which is where the tier ladder is spelt
  // out -- V3's rule that a number names its method, applied to a badge.
  //
  // NO BACKSLASHES IN THIS SCRIPT. Pkl reads `\(` inside a multi-line string
  // as INTERPOLATION, so microlith's `sed 's/^edition = "\(.*\)"/\1/p'`
  // cannot be copied verbatim. `[[]` matches a bracket with no escape, and
  // `sed 's/^edition = //p' | tr -d` replaces the capture group entirely.
  //
  // Also corrected in transit: microlith's dependency count is
  // `awk '...' f&&NF`, which counts COMMENT lines too. It returns 4 for
  // itok's 3 dependencies. The bug is invisible at zero dependencies, which
  // is the only place it has run.
  ["readme-badges"] {
    glob = List("README.md", ".coverage", "Cargo.toml", "flake.nix", "flake.lock", "hk.pkl")
    depends = List("coverage")
    check = "sh scripts/badges.sh --check"
    fix = "sh scripts/badges.sh --write"
  }
  // OFFLINE ONLY. `--offline` checks relative paths and skips every http
  // link, which is the half that breaks when a file moves and the half no
  // other step can see. External URLs are deliberately NOT checked here:
  // they need the network the rest of this gate refuses to use, and a 404
  // on someone else's site is not a reason to reject your commit.
  //
  // CHECKS EVERY DOCUMENT, deliberately ignoring {{files}}. A link breaks
  // when its TARGET moves, and the target's referrer is usually NOT in the
  // changed set -- moving CONTRIBUTING.md into `docs/` broke a README
  // pointer while README itself never appeared staged. Scoping this step to
  // changed files makes it pass on exactly the commit that breaks the link.
  //
  // The glob is `**/*` for the same reason: README links to Cargo.toml and
  // LICENSE, so a link can break with no markdown touched at all. Costs
  // nothing -- the whole run is sub-second.
  //
  // MEASURED: this repo went from 3 relative links to 25 in one commit,
  // when the docs set landed and started cross-referencing. Those 25 were
  // verified BY HAND, which is the argument for the step -- the check was
  // already necessary, it just had no runner (V17).
  //
  // Fixtures are INPUTS to tests, not prose: their content is the thing
  // under test, and one may yet need a malformed link to exercise a rule.
  // Same argument that keeps `pkl/` out of every fixer here.
  //
  // The absence guard is the ONE departure from microlith's version, which
  // has none. Without it a missing binary exits non-zero and this step
  // reports `a relative link does not resolve` -- naming a broken link when
  // the truth is a broken shell. That is B8's shape exactly, and itok's
  // three other real-binary steps (`mth`, `ripsecrets`, `semver`) all guard
  // for it, so omitting it here would be the odd one out.
  ["links"] {
    glob = List("**/*")
    check = "command -v lychee >/dev/null 2>&1 || { echo 'hk: lychee is not on PATH -- re-enter the dev shell (`nix develop`, or `direnv reload`). This is a MISSING TOOL, not a finding.' >&2; exit 1; }; lychee --offline --no-progress --exclude-path tests/fixtures . || { echo 'hk: a relative link does not resolve. Fix the path, or the file it points at.' >&2; exit 1; }"
  }
  ["taplo"] {
    glob = List("**/*.toml")
    exclude = List("pkl/**")
    check = "taplo format --check --diff {{files}}"
    fix = "taplo format {{files}}"
  }
  // `.envrc` is shell without a `.sh` name, and it is the file that runs
  // on every shell entry -- exactly where a silent mistake costs most.
  ["shellcheck"] {
    glob = List("**/*.sh", "**/*.bash", ".envrc")
    check = "shellcheck --shell=bash {{files}}"
  }
  // The flake is the toolchain definition -- it decides what every other
  // step runs with, so drift here is drift everywhere. CHECK mode only:
  // this file is hand-commented, and a formatter that rewrites on commit
  // would fight the comments rather than the code.
  ["nixfmt"] {
    glob = List("**/*.nix")
    check = "nixfmt --check {{files}}"
    fix = "nixfmt {{files}}"
  }
  // itok gates itself (V14): `.context-limits` ceilings, checked by the
  // tool being built. Triggered by the registered paths and the registry
  // itself, so a docs-only commit still gets gated.
  ["itok"] {
    glob = List("**/*.rs", "SPEC.md", "README.md", ".context-limits")
    depends = List("doctest")
    check = "cargo run -q --bin itok -- check || { echo 'hk: a registered path is over its .context-limits ceiling. Compact the file; raising the ceiling is a reviewed decision. See AGENTS.md' >&2; exit 1; }"
  }
  // The FORMAT owner runs the format rules (V14). One implementation, and
  // itok CALLS it -- the ported copy this replaces is what drifted while
  // both gates stayed green, and it never looked at section B at all.
  //
  // HARD FAILURE when the binary is absent, deliberately. The usual rule
  // is that a hook degrades rather than blocks (V74), and it applies to a
  // RUNNER whose absence leaves another guard standing. Nothing else
  // checks this spec's structure now, so degrading here would let an
  // unchecked SPEC.md through while reading exactly like a pass -- V69's
  // defect, in the one place this repo already paid for it.
  //
  // The binary is `mth`, from the package `microlith` -- two names, kept
  // apart deliberately: the path below is the PACKAGE, the command is the
  // BINARY. It comes from the dev shell, which now wraps a PINNED FLAKE
  // INPUT (`github:pr0d1r2/microlith/v0.5.0`) rather than the sibling
  // `../microlith` checkout it shimmed before the release. This step did
  // not change across that swap and could not have: it names the binary,
  // never a path -- which is why the swap was a one-line flake edit and
  // not a gate rewrite.
  ["mth"] {
    glob = List("SPEC.md", ".spec-records")
    depends = List("itok")
    check = "command -v mth >/dev/null 2>&1 || { echo 'hk: mth is not on PATH and nothing else checks SPEC.md structure. Enter the dev shell (`nix develop`, or `direnv reload`) -- it provides mth from a pinned flake input, so nothing needs to sit beside this repo. See AGENTS.md' >&2; exit 1; }; mth fmt --check SPEC.md || { echo 'hk: SPEC.md is not formatted -- one line per statement, and no line over the cap. Run `mth fmt SPEC.md`; splitting an over-long statement is the fix, raising the cap is a reviewed decision. See AGENTS.md' >&2; exit 1; }"
  }
  // Split from the step above so a formatting failure and a structural one
  // are told apart by WHICH step went red, not by reading the message --
  // and `depends` means a misformatted file is fixed before its structure
  // is judged, which is the order the diagnostics make sense in.
  ["mth-check"] {
    glob = List("SPEC.md", ".spec-records")
    depends = List("mth")
    check = "mth check --records .spec-records SPEC.md || { echo 'hk: SPEC.md failed its structural rules. Each line above names the rule, the line, why it matters, and a ranked fix -- a `mechanical` direction is safe to apply unattended, a `judgment` one is not. See AGENTS.md' >&2; exit 1; }"
  }
  // `docs/INTEGRATION.md` DESCRIBES THIS FILE, so it rots every time the
  // gate grows -- and this gate grew by six steps in three commits without
  // any document noticing. Adopted from microlith, which was deferred here
  // until now for the honest reason that there was nothing to gate: itok
  // stated no step count anywhere.
  //
  // WHAT IS CHECKED is only the arithmetic, deliberately. Every `N steps`
  // in the doc must equal the fast or the all count, and BOTH must appear,
  // so a document that quietly dropped its numbers cannot pass by saying
  // nothing. The PROSE is not checked and could not be: whether a
  // paragraph still describes what a step does is a judgement, and a
  // mechanical check that pretends to make judgements is worse than one
  // that admits its scope. This catches the half that is countable.
  //
  // NO BACKSLASHES IN THIS SCRIPT. Pkl passes `\\` through to the shell as
  // two characters, so `grep -E '\\["'` would match a literal backslash and
  // find NOTHING -- a pattern that silently counts 0 rather than erroring.
  // `[[]` matches a bracket with no escape at all.
  ["integration-doc"] {
    glob = List("hk.pkl", "docs/INTEGRATION.md")
    check = """
      fast=$(awk '/^local fast/,/^}/' hk.pkl | grep -cE '^  [[]["]')
      extra=$(awk '/^local all/,/^}/' hk.pkl | grep -cE '^  [[]["]')
      all=$((fast + extra))
      stated=$(grep -oE '[0-9]+ steps?' docs/INTEGRATION.md | grep -oE '^[0-9]+' | sort -u)
      [ -n "$stated" ] || { echo "hk: docs/INTEGRATION.md states no step count at all. It is the document that explains the gate; a count that vanished is not the same as a count that is right." >&2; exit 1; }
      bad=$(echo "$stated" | grep -vE "^($fast|$all)$" || true)
      [ -z "$bad" ] || { echo "hk: docs/INTEGRATION.md claims $(echo $bad) steps; hk.pkl defines $fast fast and $all all. The doc describes the gate, so it goes stale every time the gate grows -- fix the numbers, and check whether the new steps are described at all." >&2; exit 1; }
      echo "$stated" | grep -qx "$all" || { echo "hk: docs/INTEGRATION.md never states the all-set count ($all). Stating only the commit-side number hides drift in the half that gates a push." >&2; exit 1; }
      echo "$stated" | grep -qx "$fast" || { echo "hk: docs/INTEGRATION.md never states the fast-set count ($fast). Stating only the all count hides drift in the half you meet on every commit." >&2; exit 1; }
      """
  }
}

/// pre-push and CI add the expensive axes. Amending `fast` keeps ONE
/// definition of the cheap steps -- the slow set is the fast set plus two,
/// never a second copy that can drift.
local all = (fast) {
  // V38: the network backend is cassette-replayed offline; this axis is
  // what keeps that path from rotting.
  ["ollama"] {
    glob = List("**/*.rs")
    depends = List("itok")
    check = "cargo nextest run --features ollama || { echo 'hk: the cassette-replayed network path broke. tests/fixtures is a RECORDING -- do not edit it to make a test pass. See AGENTS.md' >&2; exit 1; }"
  }
  // V23/V13/V34 claim the core builds with ZERO network deps as a
  // dummy-only tool. Until this step existed that claim rested on reading
  // Cargo.toml; now it is a build that passes or fails.
  ["no-default-features"] {
    glob = List("**/*.rs")
    depends = List("ollama")
    check = "cargo nextest run --no-default-features || { echo 'hk: the zero-dependency core stopped building -- something outside a cfg gate reached for an optional dep. See AGENTS.md' >&2; exit 1; }"
  }
  // V39: the published .crate must contain only consumer files. An
  // untracked-but-unignored directory silently lands in it -- that is
  // exactly how `.direnv/` (5.5MB of nixpkgs source) got in, and it was
  // found by hand rather than by the gate.
  //
  // That was only half the question, and the cheaper half. This step ran
  // `--list` and threw the list away, so it proved the manifest can BUILD
  // a tarball and said nothing about what is IN one. The other half is
  // what ships MISSING, and it is invisible here BY CONSTRUCTION: the
  // repo still has the file, so the repo's own suite stays green.
  //
  // MEASURED on the real tarball, unpacked, before this was written:
  // three of eight tests in `tests/ci.rs` FAILED, because it reads
  // `hk.pkl` and `hk.pkl` is excluded. `read()` there is
  // `unwrap_or_default()`, so a missing file becomes an empty string and
  // the assertion reports `hk.pkl missing 'cargo fmt --check'` -- naming
  // a missing LINE in a file that is not there at all, which is B8's
  // shape exactly. Fixed by excluding that test rather than shipping the
  // gate: a test whose subject is dev machinery belongs with the dev
  // machinery. The other 15 failures on the tarball are the KNOWN no-git
  // case (V37/B3) that `doCheck = false` already documents -- a different
  // cause, and not this step's business.
  //
  // The required paths live in `package.metadata.itok`, NOT in this
  // script: the list and the `exclude` it guards are two halves of one
  // decision, and splitting them across two files is how they drift.
  //
  // Glob is `**/*` because DELETING a required file must trip this, and a
  // deleted file never appears in `{{files}}`. `--list` is metadata only,
  // so it stays cheap enough to keep that glob.
  ["package"] {
    glob = List("**/*")
    depends = List("no-default-features")
    check = """
      list=$(cargo package --list --allow-dirty 2>/dev/null) || { echo 'hk: `cargo package --list` failed -- the manifest cannot produce a tarball at all. Fix Cargo.toml before worrying about its contents.' >&2; exit 1; }
      missing=""
      for p in $(taplo get -f Cargo.toml 'package.metadata.itok.must-package[*]'); do
        echo "$list" | grep -qxF "$p" || missing="$missing $p"
      done
      [ -z "$missing" ] || { echo "hk: the published .crate would ship WITHOUT:$missing -- and this repo's tests would stay GREEN, because the repo still has them. Either fix the exclude list in Cargo.toml, or drop the path from must-package and say why it is no longer needed. See AGENTS.md" >&2; exit 1; }
      """
  }
  // `package` checks WHICH files ship. This checks that what ships WORKS,
  // and they are different questions -- the file list was complete on the
  // day fourteen tests failed on the tarball.
  //
  // The consumer is simulated properly or not at all: the .crate is
  // unpacked OUTSIDE this worktree, so `git rev-parse` finds nothing, and
  // ITOK_DOGFOOD is unset so the history-reading tests skip the way they
  // will for a vendorer. Unpacking under `target/` instead is the trap --
  // git commands there still resolve to THIS repo, and the same tarball
  // then fails 4 tests instead of 14. The count moved with the location,
  // which is how the tests were found to be location-sensitive at all.
  //
  // `--no-verify` on purpose, and it does not weaken anything: verify
  // COMPILES the tarball, this step compiles AND RUNS it, so keeping both
  // buys one redundant full build per push. Cargo's verify is the weaker
  // half of what happens here.
  //
  // CARGO_TARGET_DIR is pinned so the temp source path does not mean a
  // cold build every push. `--offline` keeps it networkless (V34) and
  // proves the shipped Cargo.lock resolves from cache alone.
  ["package-suite"] {
    glob = List("**/*")
    depends = List("package")
    check = """
      cargo package --allow-dirty --no-verify >/dev/null 2>&1 || { echo 'hk: `cargo package` failed -- see the `package` step, this one cannot run without a tarball.' >&2; exit 1; }
      crate=$(ls -1 target/package/*.crate 2>/dev/null | head -1)
      [ -n "$crate" ] || { echo 'hk: no .crate in target/package -- nothing to test.' >&2; exit 1; }
      crate=$PWD/$crate
      target=$PWD/target/package-suite
      d=$(mktemp -d) || exit 1
      trap 'rm -rf "$d"' EXIT
      tar xzf "$crate" -C "$d" || { echo 'hk: the .crate does not unpack.' >&2; exit 1; }
      src=$(ls -1d "$d"/*/ | head -1)
      # cargo writes REPRODUCIBLE mtimes into the .crate, so extracted
      # sources look OLDER than whatever is already in the shared target
      # dir -- cargo's fingerprint then calls them fresh and reruns the
      # PREVIOUS binary. That is a stale green, and it hit during this
      # step's own bring-up: a fix present in the tarball, on the line the
      # panic did not point at, and the test still failed. Touching costs
      # nothing and is the price of pinning the target dir at all.
      find "$src" -type f -exec touch {} + 2>/dev/null || true
      ( cd "$src" && env -u ITOK_DOGFOOD CARGO_TARGET_DIR="$target" cargo test --offline ) || { echo 'hk: the published .crate FAILS ITS OWN TESTS outside a git repo -- exactly what a consumer, vendorer or distro packager runs on registry source. `cargo package --verify` cannot see this: it only compiles. A test that needs itok own history must be gated on ITOK_DOGFOOD (see src/testutil.rs), not left to depend on where it happens to be unpacked. See AGENTS.md' >&2; exit 1; }
      """
  }
  // The docs.rs badge is a promise; broken intra-doc links break it
  // there, not here, unless this runs.
  ["rustdoc"] {
    glob = List("**/*.rs")
    depends = List("package-suite")
    env { ["RUSTDOCFLAGS"] = "-D warnings" }
    check = "cargo doc --no-deps --all-features"
  }
  // The floor is itok's OWN standalone coverage, not a workspace
  // aggregate (B4). It lives here and nowhere else.
  // Now does TWO jobs: enforce the floor, and keep `.coverage` honest.
  //
  // The cache exists so `readme-badges` can render a coverage number on
  // every commit without paying for an instrumented test run. That only
  // works if something eventually checks the cached number against a real
  // measurement -- otherwise the badge is a number nobody verifies, which is
  // worse than no badge. This is that something, and it runs on push.
  //
  // So the pair is: pre-commit RENDERS from the cache, pre-push MEASURES and
  // rejects a cache that disagrees. `hk run refresh` is how you update both.
  // ONE DECIMAL, TRUNCATED, both sides -- a correctness fix, not a loosened
  // check. Coverage is PLATFORM-DEPENDENT: the identical source measured
  // 98.04 on macOS and 98.06 on ubuntu, so the exact-string comparison this
  // used to do could not be satisfied on both at once. Committing either
  // number broke the other machine, and the platform matrix (T60) would
  // have made it three. A figure no single machine can reproduce is not a
  // measurement, and a badge should not print one (B20).
  //
  // TRUNCATED rather than rounded, and the distinction is the whole fix:
  // `%.1f` ROUNDS 98.04 to 98.0 and 98.06 to 98.1, so the two measurements
  // straddle the boundary and the check still fails. `int(x*10)/10` sends
  // both to 98.0. It also FLOORS, so the badge can only ever understate --
  // the safe direction for a published claim.
  //
  // The floor keeps its full precision: `--fail-under-lines 98` is a
  // threshold, not a displayed claim, so sub-decimal jitter cannot move it.
  ["coverage"] {
    glob = List("**/*.rs", "SPEC.md", "tests/fixtures/**", ".coverage")
    depends = List("rustdoc")
    check = """
      mkdir -p target
      cargo llvm-cov nextest --features ollama --fail-under-lines 98 --summary-only > target/coverage.txt || { cat target/coverage.txt >&2; echo 'hk: below the coverage floor. Cover the gap; lowering the floor needs a reason in SPEC.md. See AGENTS.md' >&2; exit 1; }
      cat target/coverage.txt
      measured=$(awk '/^TOTAL/{gsub("%","",$10); printf "%.1f", int($10*10)/10}' target/coverage.txt)
      cached=$(awk '/^lines /{printf "%.1f", int($2*10)/10}' .coverage)
      [ "$measured" = "$cached" ] || { echo "hk: .coverage says $cached% but the measurement is $measured%, so the README badge is rendering a stale number. Run 'hk run refresh' to update the cache and the badge, then amend." >&2; exit 1; }
      """
    fix = """
      mkdir -p target
      cargo llvm-cov nextest --features ollama --fail-under-lines 98 --summary-only > target/coverage.txt || { cat target/coverage.txt >&2; exit 1; }
      measured=$(awk '/^TOTAL/{gsub("%","",$10); printf "%.1f", int($10*10)/10}' target/coverage.txt)
      key=$(git ls-files -s -- '*.rs' SPEC.md tests/fixtures | git hash-object --stdin)
      awk -v k="$key" -v m="$measured" '/^key /{print "key " k; next} /^lines /{print "lines " m; next} {print}' .coverage > target/.coverage.new
      mv target/.coverage.new .coverage
      """
  }
  // THE VERSION LADDER, MECHANICALLY. V70 makes each minor a level of
  // GUARANTEE rather than a feature count, and V39 requires SemVer to tell
  // maturity true. Both describe a PROMISE about what a version number
  // means, and the only thing between a breaking change and a minor bump
  // has been somebody remembering to look -- stated in two places,
  // enforced in none (V17).
  //
  // BASELINE IS A GIT TAG, not the crates.io index, on purpose:
  //   * offline, like everything else in this gate
  //   * it works at `0.7.0-rc.1` (T59), before the registry has anything
  //     to compare against -- which is exactly when the first real check
  //     is wanted
  //   * a tag is ours; the index requires the crate to already exist, and
  //     itok is not published
  // The accepted cost is DRIFT: publishing from an untagged tree makes the
  // baseline a lie, and green against the wrong baseline is worse than no
  // check at all. T59's release procedure tags, and that is what keeps
  // this honest.
  //
  // VACUOUS TODAY, AND IT SAYS SO. This repo has no tags at all, so there
  // is no prior API to diff against and the step reports that on stderr
  // every run rather than passing quietly. A vacuous pass ANNOUNCED is a
  // different thing from a vacuous pass HIDDEN. It arms itself at the
  // first `v*` tag -- which is T59, the same commit that first makes a
  // version number permanent.
  // A PRE-RELEASE MUST NOT OUTRANK ITS RELEASE. `--sort=-v:refname` puts
  // `v0.3.0-rc.1` ABOVE `v0.3.0` by default: git's version sort has no
  // notion of a semver pre-release, so the longer refname wins. Publishing
  // 0.3.0 therefore did NOT move the baseline off the rc, and every run
  // after it would have diffed against a tag that (a) is older and (b) is
  // the one this toolchain cannot build.
  //
  // `versionsort.suffix=-` tells git that `-` introduces a pre-release, so
  // `v0.3.0` sorts first. MEASURED both ways on the two real tags (B23).
  //
  // Found by checking a claim rather than trusting it: the whole point of
  // cutting `v0.3.0` was to arm this step, and it was still reporting
  // BASELINE UNBUILDABLE afterwards.
  //
  // THE BASELINE CAN ALSO OUTLIVE ITS TOOLCHAIN, and that failure looks
  // like a broken API if nothing separates the two causes.
  //
  // `v0.3.0-rc.1` declares `rust-version = "1.96"` -- frozen, because a
  // published tag's manifest cannot be edited. Moving the dev shell to
  // nixos 26.05 put rustc at 1.95.0, so cargo refuses to build the
  // BASELINE at all:
  //
  //   error: rustc 1.95.0 is not supported by the following package:
  //     itok@0.3.0-rc.1 requires rustc 1.96
  //   error: failed to build rustdoc for crate itok v0.3.0-rc.1
  //
  // The old catch-all then announced "the pub API broke", which is B8's
  // exact defect -- a check naming the wrong cause is worse than one that
  // misses, because it sends the reader to restore an API that never
  // changed. The rust-version comparison below distinguishes them and says
  // it examined NOTHING, the same shape as the NO BASELINE branch.
  //
  // It self-clears: the next tag is cut on the current toolchain, so its
  // frozen rust-version will be buildable by definition.
  //
  // The comparison uses two `echo`s rather than `printf '%s\n%s\n'` on
  // purpose. Pkl renders a backslash in these strings LITERALLY, so the
  // printf form reached the shell as `%s\\n%s\\n` and emitted both versions
  // on ONE line separated by a literal backslash-n. `sort -V | head -1` then
  // returned that whole string, which never equals `$want`, so the guard
  // skipped unconditionally -- a check that always says "I examined
  // nothing" is no better than a deleted one.
  ["semver"] {
    glob = List("src/**/*.rs", "Cargo.toml")
    depends = List("coverage")
    check = """
      cargo semver-checks --version >/dev/null 2>&1 || { echo 'hk: cargo-semver-checks is not on PATH -- re-enter the dev shell (`nix develop`, or `direnv reload`). This is a MISSING TOOL, not a finding.' >&2; exit 1; }
      baseline=$(git -c versionsort.suffix=- tag --list 'v*' --sort=-v:refname | head -1)
      [ -n "$baseline" ] || { echo 'hk: semver: NO BASELINE -- no release tag exists yet, so there is no prior API to diff against. This step arms itself at the first `v*` tag; it is reporting that it examined nothing, not that it found nothing.' >&2; exit 0; }
      want=$(git show "$baseline:Cargo.toml" 2>/dev/null | awk -F'"' '/^rust-version/{print $2; exit}')
      have=$(rustc --version | awk '{print $2}')
      lowest=$({ echo "$want"; echo "$have"; } | sort -V | head -1)
      if [ -n "$want" ] && [ "$lowest" != "$want" ]; then
        echo "hk: semver: BASELINE UNBUILDABLE -- $baseline declares rust-version $want and this toolchain is $have, so cargo refuses to build the baseline's rustdoc and NOTHING was compared. A published tag's manifest is frozen; the toolchain moved under it. This clears itself at the first tag cut on the current toolchain. Reporting that it examined nothing, not that it found nothing." >&2
        exit 0
      fi
      cargo semver-checks check-release --baseline-rev "$baseline" || { echo "hk: the pub API broke against $baseline. Either restore it, or take the version bump semver requires -- V70's ladder is a promise to consumers, and crates.io is immutable, so a wrong rung cannot be corrected. See AGENTS.md" >&2; exit 1; }
      """
  }
}

hooks {
  /// Fast set only: a hook you are tempted to `--no-verify` past is worse
  /// than no hook. `stash = "git"` is correctness, not speed -- without it
  /// a partially staged file (`git add -p`) is checked as it looks in the
  /// worktree, giving a verdict about code you are not committing.
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = fast
  }
  ["pre-push"] {
    steps = all
  }
  /// What `hk check` runs -- the CI entry point. Flat and complete: CI has
  /// no fail-fast-cheapest-first gradient to optimize for.
  ["check"] {
    steps = all
  }
  ["fix"] {
    fix = true
    steps = fast
  }
  /// `hk run refresh` -- the only way to update `.coverage` and, through it,
  /// the README coverage badge. `fix` over the SLOW set, because the number
  /// it caches costs a full instrumented run; the ordinary `fix` hook stays
  /// on `fast` so a commit never pays for one.
  ///
  /// Needed as its own entry point precisely BECAUSE the cache is cheap to
  /// read: nothing in the commit path can notice the number has moved, so
  /// updating it has to be a thing you ask for. `coverage` on push is what
  /// tells you to.
  ["refresh"] {
    fix = true
    steps = all
  }
}
