/target
/.direnv
hk.local.pkl

# `nix build` drops a symlink into the store here. CI runs three of them
# (V62's packages), so this is a file every contributor will produce.
/result

# Harness transcripts hold real conversation content -- file bodies,
# message text, whatever a hook printed. One must never be committed
# (V45), and git history is forever. Curated fixtures are exempt: they
# are hand-written, synthetic, and the tests need them.
*.jsonl
!tests/fixtures/**/*.jsonl
