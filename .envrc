# direnv: auto-enter the pinned toolchain. The flake sits at the repo
# ROOT -- this is a standalone crate headed for opensource, so it carries
# an ordinary root `flake.nix` like any Rust project, not a unit-of-work
# declaration (that belongs to the monorepo home, V31's two-tier split).
# Root also means the flake can SEE `Cargo.toml`/`src/`, which a flake in
# a subdirectory cannot.
use flake
